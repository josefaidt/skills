{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "sortImports": {
    "groups": ["type", "builtin", "external", ["parent", "sibling", "index"]],
    "newlinesBetween": false
  },
  "sortPackageJson": true,
  // A paragraph stays on one line, so a diff shows the sentence that changed
  "proseWrap": "never",
  "overrides": [
    {
      "files": ["*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    ".claude/worktrees/*",
    // eval fixtures are data: expected.json points at their line numbers, so formatting must not move them
    "evals/shared/*/base/**",
    "evals/*/*/environment/**"
  ]
}
