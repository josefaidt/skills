#!/bin/sh
set -e

[ -n "$CI" ] && exit 0

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|cjs|mjs|cts|mts|json|jsonc|yaml|yml|toml|css|scss|less|md|mdx|graphql|vue|svelte|html)$' || true)

[ -z "$STAGED" ] && exit 0

STAGED_LINT=$(echo "$STAGED" | grep -E '\.(ts|tsx|js|jsx|cjs|mjs|cts|mts|vue|svelte|astro)$' || true)

# The repository's own binaries, so the hook never depends on what happens to be on PATH
BIN="$(git rev-parse --show-toplevel)/node_modules/.bin"
if [ ! -x "$BIN/oxfmt" ] || [ ! -x "$BIN/oxlint" ]; then
  echo "pre-commit: oxfmt or oxlint is not installed. Run 'bun install', then commit again." >&2
  exit 1
fi

# --no-error-on-unmatched-pattern lets a commit of only ignored files, such as eval fixtures, through
echo "$STAGED" | xargs "$BIN/oxfmt" --no-error-on-unmatched-pattern
[ -n "$STAGED_LINT" ] && echo "$STAGED_LINT" | xargs "$BIN/oxlint" --fix --no-error-on-unmatched-pattern
echo "$STAGED" | xargs git add

# each eval task carries its own copy of the shared files, so a commit to evals/ must keep them in step
if git diff --cached --name-only | grep -q '^evals/'; then
  bun "$(git rev-parse --show-toplevel)/evals/sync.ts" --check
fi
